{
  "name": "sky-ceda-innovation-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Sky - the CEDA Innovation Portal: submit, evaluate, track and award youth-led innovation in Botswana.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/select-provider.mjs && prisma generate && node scripts/prepare-db.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "node scripts/select-provider.mjs && prisma db push --force-reset && tsx prisma/seed.ts",
    "setup": "node scripts/select-provider.mjs && prisma generate && prisma db push && tsx prisma/seed.ts",
    "postinstall": "node scripts/select-provider.mjs && prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.15",
    "lucide-react": "^0.552.0",
    "motion": "^14.10.1",
    "next": "^15.5.29",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/topojson-client": "^3.1.5",
    "d3-geo": "^3.1.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.5",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "world-atlas": "^2.0.2"
  }
}
