{
 "name": "Sky upgraded",
 "origin": "http://localhost:3102",
 "bp": "/ceda-innovation-portal/skyplus",
 "out": "/home/user/site/skyplus",
 "publicStart": [
  "/",
  "/calls/",
  "/tour/",
  "/login/",
  "/register/",
  "/privacy/",
  "/verify/"
 ],
 "loginPaths": [
  "/login/"
 ],
 "defaultHome": "/app/innovator/",
 "logins": {
  "naledi@demo.ceda.bw": "/app/innovator/",
  "thabo.eval@demo.ceda.bw": "/app/evaluator/",
  "lesego.adj@demo.ceda.bw": "/app/adjudicator/",
  "admin@demo.ceda.bw": "/app/admin/",
  "dpo@demo.ceda.bw": "/app/dpo/"
 },
 "roles": [
  {
   "name": "innovator",
   "label": "Innovator",
   "home": "/app/innovator/",
   "own": [
    "/app/innovator",
    "/app/privacy"
   ],
   "login": [
    {
     "goto": "/login/"
    },
    {
     "click": "form:has(input[value='naledi@demo.ceda.bw']) button"
    },
    {
     "waitUrl": "/app/"
    }
   ],
   "api": [
    "/api/notifications",
    "/api/me"
   ]
  },
  {
   "name": "evaluator",
   "label": "Evaluator",
   "home": "/app/evaluator/",
   "login": [
    {
     "goto": "/login/"
    },
    {
     "click": "form:has(input[value='thabo.eval@demo.ceda.bw']) button"
    },
    {
     "waitUrl": "/app/"
    }
   ]
  },
  {
   "name": "adjudicator",
   "label": "Committee",
   "home": "/app/adjudicator/",
   "login": [
    {
     "goto": "/login/"
    },
    {
     "click": "form:has(input[value='lesego.adj@demo.ceda.bw']) button"
    },
    {
     "waitUrl": "/app/"
    }
   ]
  },
  {
   "name": "admin",
   "label": "Admin",
   "home": "/app/admin/",
   "own": [
    "/app/reports"
   ],
   "login": [
    {
     "goto": "/login/"
    },
    {
     "click": "form:has(input[value='admin@demo.ceda.bw']) button"
    },
    {
     "waitUrl": "/app/"
    }
   ]
  },
  {
   "name": "dpo",
   "label": "Data protection",
   "home": "/app/dpo/",
   "login": [
    {
     "goto": "/login/"
    },
    {
     "click": "form:has(input[value='dpo@demo.ceda.bw']) button"
    },
    {
     "waitUrl": "/app/"
    }
   ]
  }
 ]
}